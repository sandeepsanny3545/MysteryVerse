# ==========================================
# MysteryVerse Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Client Origin(s) for Backend CORS
# Local Development:
CLIENT_URL=http://localhost:5173
# Production (Render Backend Web Service):
# CLIENT_URL=https://mysteryverse-frontend.onrender.com

# Frontend API URL (Vite Client)
# Local Development:
VITE_API_URL=http://localhost:5000/api
# Production (Render Frontend Static Site):
# VITE_API_URL=https://mysteryverse-pg2r.onrender.com/api

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/mysteryverse
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mysteryverse?retryWrites=true&w=majority

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
