# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Client Origins for CORS (comma-separated if multiple)
# Local: http://localhost:5173
# Production (Render Backend Web Service Environment Variable):
# CLIENT_URL=https://mysteryverse-frontend.onrender.com
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mysteryverse

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
